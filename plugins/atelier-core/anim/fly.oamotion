// Fly: travels along `direction` (0 = right, 90 = down). An intro arrives moving that
// way (from the opposite side); an outro leaves moving that way. `distance` 1 takes the
// layer a full canvas off, whatever the angle.

// Ease-out cubic: fast at first, settling gently.
let eased = 1 - (1 - clamp(visibility, 0, 1)) ^ 3;
let a = direction * PI / 180;
let dx = cos(a);
let dy = sin(a);
// Far enough along the direction to clear the canvas, stretched for diagonals so both
// axes clear.
let reach = (abs(dx) * canvas_w + abs(dy) * canvas_h) / max(max(abs(dx), abs(dy)), 0.000001);
let away = (1 - eased) * reach * distance * select(leaving, 1, -1);
move_x = dx * away;
move_y = dy * away;
opacity = select(fade, eased, 1);
