// Denoise: spectral gating against a tracked noise floor.
spectrum 1024;

// Each bin's smoothed power; the noise floor follows it down at once and creeps up
// slowly, so steady noise is tracked while speech and music (which come and go) aren't.
// The first windows (the buffer still filling) set the floor outright.
let power = mag * mag;
state windows = 0;
let first = windows < 8;
windows += 1;
state smooth = 0;
smooth = select(first, power, smooth * 0.85 + power * 0.15);
state floor_power = 0;
floor_power = select(first || smooth < floor_power, smooth, floor_power * 1.004 + 1e-12);

// A minimum sits below the average: ~2.2× brings it back to the noise level. Decide on
// lightly smoothed power (raw noise power swings too much), and subtract the noise,
// over-subtracting by `sensitivity`.
state fast = 0;
fast = select(first, power, fast * 0.5 + power * 0.5);
let keep = sqrt(max(1 - clamp(sensitivity, 0.1, 10) * floor_power * 2.2 / max(fast, 1e-12), 0));

pass;
// Smoothed across neighboring bins and over time, never below the floor: lone bins
// poking through the noise are what sounds like "musical noise".
let near = (at(keep, bin - 1) + 2 * keep + at(keep, bin + 1)) / 4;
state gain = 1;
gain = gain * 0.5 + max(near, db(-clamp(reduction, 0, 60))) * 0.5;
mag *= gain;
