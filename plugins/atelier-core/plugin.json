        {"id": "p1_q", "type": "float", "default": 1, "min": 0.2, "max": 10},
        {"id": "p2_freq", "type": "float", "default": 1500, "min": 40, "max": 18000},
        {"id": "p2_gain", "type": "float", "default": 0, "min": -18, "max": 18, "unit": "decibels"},
        {"id": "p2_q", "type": "float", "default": 1, "min": 0.2, "max": 10},
        {"id": "p3_freq", "type": "float", "default": 5000, "min": 40, "max": 18000},
        {"id": "p3_gain", "type": "float", "default": 0, "min": -18, "max": 18, "unit": "decibels"},
