      "params": [{"id": "curve", "type": "float", "default": 1, "min": 0.25, "max": 4}],
      "shader": {"source": "out = in * pow(visibility, curve);"}
    },
    {
      "id": "oa.audio.muffle", "name": "Muffle", "kind": "sound", "category": "Sound",
      "description": "Dull and far away, as if through a wall. As an intro it opens up; as an outro it closes in.",
      "params": [
        {"id": "cutoff", "type": "float", "default": 600, "min": 80, "max": 8000},
        {"id": "amount", "type": "float", "default": 1, "min": 0, "max": 1}
      ],
      "shader": {"file": "sound/muffle.oasound"}
    },
    {
      "id": "oa.audio.tone", "name": "Tone", "kind": "sound", "category": "Sound",
      "description": "Adds a tone on top of the sound: a sine, square, triangle or saw wave (or noise) at a pitch, with its own attack, decay and repeats.",
      "params": [
        {"id": "wave", "type": "enum", "options": ["sine", "square", "triangle", "saw", "noise"]},
        {"id": "pitch", "type": "float", "default": 440, "min": 20, "max": 8000},
        {"id": "gain", "type": "float", "default": -12, "min": -60, "max": 0, "unit": "decibels"},
        {"id": "attack", "type": "float", "default": 0.01, "min": 0, "max": 2, "unit": "seconds"},
        {"id": "decay", "type": "float", "default": 0, "min": 0, "max": 10, "unit": "seconds"},
        {"id": "repeat", "type": "float", "default": 0, "min": 0, "max": 10, "unit": "seconds"},
        {"id": "vibrato", "type": "float", "default": 0, "min": 0, "max": 12},
        {"id": "vibrato_depth", "type": "float", "default": 0.5, "min": 0, "max": 2},
        {"id": "pulse", "type": "float", "default": 0.5, "min": 0.05, "max": 0.95},
        {"id": "follow", "type": "float", "default": 0, "min": 0, "max": 1},
        {"id": "original", "type": "float", "default": 1, "min": 0, "max": 1}
      ],
      "shader": {"file": "sound/tone.oasound"}
    },
    {
      "id": "oa.audio.tremolo", "name": "Tremolo", "kind": "sound", "category": "Sound",
      "description": "The level swings up and down.",
      "params": [
        {"id": "speed", "type": "float", "default": 5, "min": 0.1, "max": 20},
        {"id": "depth", "type": "float", "default": 0.5, "min": 0, "max": 1}
      ],
      "shader": {"source": "let swing = 0.5 + 0.5 * sin(TAU * speed * time);\nout = in * (1 - depth * swing);"}
    },
    {
      "id": "oa.audio.drive", "name": "Drive", "kind": "sound", "category": "Sound",
      "description": "Warm saturation, up to a fuzzy distortion.",
      "params": [
        {"id": "drive", "type": "float", "default": 12, "min": 0, "max": 36, "unit": "decibels"},
        {"id": "mix", "type": "float", "default": 1, "min": 0, "max": 1}
      ],
      "shader": {"source": "let d = db(drive);\nout = mix(in, tanh(in * d) / tanh(d), mix);"}
    },
    {
      "id": "oa.audio.width", "name": "Stereo Width", "kind": "sound", "category": "Sound", "meter": "correlation",
      "description": "Narrower (0 is mono) or wider than it was recorded.",
      "params": [{"id": "width", "type": "float", "default": 1.5, "min": 0, "max": 3}],
      "shader": {"source": "let mid = (left + right) * 0.5;\nlet side = (left - right) * 0.5 * width;\nout = select(channels < 2, in, select(channel == 0, mid + side, mid - side));"}
    }
  ]
}
