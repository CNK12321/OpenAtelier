      ],
      "shader": {"file": "sound/eq.oasound"}
    },
    {
      "id": "oa.audio.compressor", "name": "Compressor", "kind": "sound", "category": "Sound", "meter": "reduction",
      "description": "Evens out the level: whatever goes over the threshold is turned down by the ratio.",
      "params": [
        {"id": "threshold", "type": "float", "default": -18, "min": -60, "max": 0, "unit": "decibels"},
        {"id": "ratio", "type": "float", "default": 4, "min": 1, "max": 20},
        {"id": "attack", "type": "float", "default": 0.01, "min": 0.0001, "max": 0.2, "unit": "seconds"},
