    {
      "id": "oa.light.shadow", "name": "Drop Shadow", "kind": "spatial", "category": "Light",
      "bounds": "let reach = (abs(distance) + abs(softness)) * raster_scale;\nleft = x0 - reach;\ntop = y0 - reach;\nright = x1 + reach;\nbottom = y1 + reach;",
      "params": [
        {"id": "color", "type": "color", "default": [0, 0, 0, 1]},
        {"id": "opacity", "type": "float", "default": 0.6, "min": 0, "max": 1},
        {"id": "direction", "type": "float", "default": 45, "min": 0, "max": 360, "unit": "direction"},
        {"id": "distance", "type": "float", "default": 14, "min": 0, "max": 400, "unit": "layer_pixels"},
        {"id": "softness", "type": "float", "default": 12, "min": 0, "max": 200, "unit": "layer_pixels"}
