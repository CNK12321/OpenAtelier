        {"id": "reduction", "type": "float", "default": 18, "min": 0, "max": 40, "unit": "decibels"},
        {"id": "sensitivity", "type": "float", "default": 2, "min": 0.5, "max": 4}
      ],
      "shader": {"file": "sound/denoise.oasound"}
    },
    {
      "id": "oa.audio.fade", "name": "Fade", "kind": "sound", "category": "Sound", "usage": "in_out",
